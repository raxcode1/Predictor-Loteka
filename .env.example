# Variables de entorno para ejecutar localmente (PC)
# Copia este archivo como .env y rellena los valores reales.
# No subas este archivo con credenciales reales a GitHub.

# Sesión de administrador (requerida para /api/auth y acceso al dashboard)
SESSION_SECRET=una-cadena-aleatoria-y-larga
ADMIN_USERNAME=admin
ADMIN_PASSWORD=una-contraseña-larga-y-unica

# Vercel Blob (opcional, solo si usas Blob para persistir resultados en la nube)
BLOB_READ_WRITE_TOKEN=
